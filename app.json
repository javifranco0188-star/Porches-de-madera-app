{
  "expo": {
    "name": "Porches de Madera Baratos",
    "slug": "porches-de-madera-baratos",
    "version": "3.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF4E8",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FAF4E8"
    },
    "android": {
      "package": "com.porchesdemaderabaratos.app",
      "versionCode": 5,
      "permissions": ["READ_MEDIA_IMAGES"],
      "adaptiveIcon": {
        "backgroundColor": "#FAF4E8"
      }
    },
    "ios": {
      "bundleIdentifier": "com.porchesdemaderabaratos.app",
      "supportsTablet": true
    },
    "plugins": ["expo-image-picker"],
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "Porches de Madera Baratos",
      "shortName": "Porches Madera"
    }
  }
}
